    if s.chars().all(|c| (c as u32) < 256) {
        let latin1 = s.chars().map(|c| c as u8).collect::<Vec<_>>();
        let expected = expected
            .iter()
            .copied()
            .map(|s| s.chars().map(|c| c as u8).collect::<Vec<_>>())
            .collect::<Vec<_>>();
        let segments = segmenter
            .segment_latin1(&latin1)
            .tuple_windows()
            .map(|(a, b)| &latin1[a..b])
